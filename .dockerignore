# ==============================================================================
# Docker 构建上下文忽略清单
# 避免将本地缓存、构建中间产物及机密信息发送到 Docker 守护进程
# ==============================================================================

# 版本控制、CI 与本地工程脚本
.git
.github
.githooks
scripts
.cliff.toml
.gitignore
.gitattributes
.dockerignore

# 操作系统、IDE 与临时目录
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.idea
.vscode
tmp
temp
.tmp
.temp
*.tmp
*.temp
scratch
.scratch
scratchpad
.scratchpad
sandbox
.sandbox

# 测试覆盖率与代码分析缓存
coverage
*.lcov
.nyc_output
.pytest_cache
.ruff_cache
.mypy_cache
.eslintcache

# 敏感文件与本地环境变量
.env
.env.*
!.env.example

# 日志与依赖缓存
*.log
logs
node_modules
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
dist
dist-artifacts
docs/.vitepress/dist
docs/.vitepress/cache
